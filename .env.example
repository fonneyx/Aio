# Copy to .env (Docker) or server/.env (running from source). Every setting is optional.

# Require a login when the server is reachable from other devices. Format: user:password
# AIO_AUTH=me:a-long-random-password

# Telegram bot token from @BotFather, and the Telegram user IDs allowed to use it (the bot tells you yours).
# AIO_TELEGRAM_TOKEN=123456:ABC...
# AIO_TELEGRAM_USERS=11111111,22222222

# Sites that need a login (Instagram, some Vimeo and Reddit content): a Netscape cookies.txt file.
# AIO_COOKIES_FILE=/data/cookies.txt

# Outbound proxy for extraction, e.g. when a site blocks your server's network.
# AIO_PROXY=http://user:pass@host:port

# AIO_WORKERS=2            # downloads processed in parallel
# AIO_FILE_TTL_HOURS=24    # how long finished files are kept
